<resources>

    <!-- Material 3, DayNight. Follows system light/dark on all API levels via the
         library's internal -night theme selection. Material You dynamic colors are
         applied at runtime by DynamicColors (MaiseApplication): API 31+ uses the
         system accent/wallpaper palette; API 26-30 keep the static M3 baseline
         palette. The transparent status bar is required for API 26-34; on API 35+
         (edge-to-edge enforced) the color attr is ignored and only the
         windowLightStatusBar appearance split matters. -->
    <style name="Theme.Maise" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Filled text field with no stroke and fully rounded corners -->
    <style name="RoundedFilledInput" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">0dp</item>
        <item name="boxBackgroundColor">?attr/colorSurfaceContainerHighest</item>
        <item name="shapeAppearanceOverlay">@style/RoundedCornerShape</item>
    </style>

    <style name="RoundedCornerShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <!-- Floating dialog theme for MaiseRecognizeActivity: compact card over a
         dimmed (but visible) view of the calling app. Implicit parent Theme.Maise
         resolves per-configuration at runtime, so night mode picks up the
         values-night Theme.Maise. -->
    <style name="Theme.Maise.Recognize">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.4</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@style/RecognizeWindowAnimation</item>
        <item name="windowNoTitle">true</item>
        <!-- Keep the card at its literal surface color — the elevation overlay
             otherwise lightens it in proportion to cardElevation. -->
        <item name="elevationOverlayEnabled">false</item>
    </style>

    <style name="RecognizeWindowAnimation">
        <item name="android:windowEnterAnimation">@anim/recognize_window_enter</item>
        <item name="android:windowExitAnimation">@anim/recognize_window_exit</item>
    </style>

</resources>