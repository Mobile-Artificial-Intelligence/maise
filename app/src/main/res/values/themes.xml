<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Maise" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/on_surface</item>
        <item name="colorOnPrimary">@color/app_background</item>
        <item name="colorPrimaryVariant">@color/surface</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:textColorPrimary">@color/on_surface</item>
        <item name="android:textColorSecondary">@color/hint_text</item>
        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>

    <!-- Filled text field with no stroke and fully rounded corners -->
    <style name="RoundedFilledInput" parent="Widget.MaterialComponents.TextInputLayout.FilledBox">
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">0dp</item>
        <item name="boxBackgroundColor">@color/surface</item>
        <item name="shapeAppearanceOverlay">@style/RoundedCornerShape</item>
        <item name="hintTextColor">@color/hint_text</item>
        <item name="android:textColorHint">@color/hint_text</item>
    </style>

    <style name="RoundedCornerShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <!-- Floating dialog theme for MaiseRecognizeActivity: compact card over a
         dimmed (but visible) view of the calling app. -->
    <style name="Theme.Maise.Recognize">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.4</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@style/RecognizeWindowAnimation</item>
        <item name="windowNoTitle">true</item>
        <!-- Keep the card at its literal surface color — MDC's elevation overlay
             otherwise lightens it in proportion to cardElevation. -->
        <item name="elevationOverlayEnabled">false</item>
    </style>

    <style name="RecognizeWindowAnimation">
        <item name="android:windowEnterAnimation">@anim/recognize_window_enter</item>
        <item name="android:windowExitAnimation">@anim/recognize_window_exit</item>
    </style>

</resources>
